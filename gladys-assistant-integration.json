          "value": "deg_8_5",
          "label": {
            "en": "Sun 8.5° below the horizon",
            "fr": "Soleil à 8,5° sous l'horizon",
            "de": "Sonne 8,5° unter dem Horizont",
            "es": "Sol a 8,5° bajo el horizonte"
          }
        },
