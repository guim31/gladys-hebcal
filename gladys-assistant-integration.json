{
  "manifest_version": 1,
  "type": "device",
  "name": "Hebrew Calendar",
  "description": {
    "en": "Hebrew date, Shabbat, holidays, candle lighting, havdalah, Torah portion and Omer, computed at home.",
    "fr": "Date hébraïque, chabbat, fêtes, allumage des bougies, havdala, paracha et Omer, calculés chez vous.",
    "de": "Hebräisches Datum, Schabbat, Feiertage, Kerzenzünden, Hawdala, Parascha und Omer, lokal berechnet.",
    "es": "Fecha hebrea, Shabat, festividades, velas, havdalá, parashá y Ómer, calculados en su hogar."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-hebcal:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-hebcal/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Everything is computed inside Gladys, without any internet service, from the coordinates of your house (Settings > Houses) and in the Gladys timezone (Settings > System), with the engine of hebcal.com. The Hebrew day starts at sunset.",
        "fr": "Tout est calculé dans Gladys, sans aucun service internet, à partir des coordonnées de votre maison (Paramètres > Maisons) et dans le fuseau horaire de Gladys (Paramètres > Système), avec le moteur de hebcal.com. Le jour hébraïque commence au coucher du soleil.",
        "de": "Alles wird in Gladys berechnet, ohne Internetdienst, aus den Koordinaten deines Zuhauses (Einstellungen > Zuhause) und in der Zeitzone von Gladys (Einstellungen > System), mit der Rechenmaschine von hebcal.com. Der hebräische Tag beginnt mit dem Sonnenuntergang.",
        "es": "Todo se calcula en Gladys, sin ningún servicio de internet, a partir de las coordenadas de su vivienda (Configuración > Viviendas) y en la zona horaria de Gladys (Configuración > Sistema), con el motor de hebcal.com. El día hebreo empieza con la puesta del sol."
      },
      "links": [
        {
          "url": "https://www.hebcal.com/home/category/halachic-times",
          "label": {
            "en": "About the times (hebcal.com)",
            "fr": "À propos des horaires (hebcal.com)",
            "de": "Über die Zeiten (hebcal.com)",
            "es": "Sobre los horarios (hebcal.com)"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the sensor names, of the times and of the scene texts. Names are set when the device is created: to rename them after a change, delete and re-add the device.",
        "fr": "Langue des noms de capteurs, des horaires et des textes des scènes. Les noms sont fixés à la création de l'appareil : pour les renommer après un changement, supprimez puis rajoutez l'appareil.",
        "de": "Sprache der Sensornamen, der Uhrzeiten und der Szenentexte. Die Namen werden beim Anlegen des Geräts festgelegt: Um sie nach einer Änderung umzubenennen, lösche das Gerät und füge es erneut hinzu.",
        "es": "Idioma de los nombres de los sensores, de los horarios y de los textos de las escenas. Los nombres se fijan al crear el dispositivo: para cambiarlos después de una modificación, elimine el dispositivo y vuelva a añadirlo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "names",
      "type": "select",
      "label": {
        "en": "Holiday and month names",
        "fr": "Noms des fêtes et des mois",
        "de": "Namen der Feiertage und Monate",
        "es": "Nombres de las festividades y los meses"
      },
      "description": {
        "en": "Usual names in the language of the texts (transliterated when there is none), a transliteration, or Hebrew script.",
        "fr": "Noms usuels dans la langue des textes (translittérés s'il n'y en a pas), une translittération, ou l'écriture hébraïque.",
        "de": "Übliche Namen in der Sprache der Texte (sonst transliteriert), eine Transliteration oder hebräische Schrift.",
        "es": "Nombres habituales en el idioma de los textos (transliterados si no los hay), una transliteración o la escritura hebrea."
      },
