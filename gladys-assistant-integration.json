            "es": "Nombres habituales (Pésaj, Sucot)"
          }
        },
        {
          "value": "sephardic",
          "label": {
            "en": "Transliterated, Sephardic (Shavuot)",
            "fr": "Translittérés, séfarades (Shavuot)",
            "de": "Transliteriert, sefardisch (Shavuot)",
            "es": "Transliterados, sefardíes (Shavuot)"
          }
        },
        {
          "value": "ashkenazi",
          "label": {
            "en": "Transliterated, Ashkenazi (Shavuos)",
            "fr": "Translittérés, ashkénazes (Shavuos)",
            "de": "Transliteriert, aschkenasisch (Shavuos)",
            "es": "Transliterados, asquenazíes (Shavuos)"
          }
        },
        {
          "value": "hebrew",
          "label": {
            "en": "Hebrew script (שבועות)",
            "fr": "Écriture hébraïque (שבועות)",
            "de": "Hebräische Schrift (שבועות)",
            "es": "Escritura hebrea (שבועות)"
          }
        }
      ]
    },
    {
      "key": "region",
      "type": "select",
      "label": {
        "en": "Israel or diaspora",
        "fr": "Israël ou diaspora",
        "de": "Israel oder Diaspora",
        "es": "Israel o diáspora"
      },
      "description": {
        "en": "The holidays (one or two days) and the weekly portion differ. Automatic: Israel when the Gladys timezone is Asia/Jerusalem.",
        "fr": "Les fêtes (un ou deux jours) et la paracha diffèrent. Automatique : Israël si le fuseau horaire de Gladys est Asia/Jerusalem.",
        "de": "Die Feiertage (ein oder zwei Tage) und der Wochenabschnitt unterscheiden sich. Automatisch: Israel, wenn die Zeitzone von Gladys Asia/Jerusalem ist.",
        "es": "Las festividades (uno o dos días) y la parashá difieren. Automático: Israel si la zona horaria de Gladys es Asia/Jerusalem."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "fr": "Automatique",
            "de": "Automatisch",
            "es": "Automático"
          }
        },
        {
          "value": "diaspora",
          "label": {
            "en": "Diaspora",
            "fr": "Diaspora",
            "de": "Diaspora",
            "es": "Diáspora"
          }
        },
        {
          "value": "israel",
          "label": {
            "en": "Israel",
            "fr": "Israël",
            "de": "Israel",
            "es": "Israel"
          }
        }
      ]
    },
    {
      "key": "candle_minutes",
      "type": "number",
      "label": {
        "en": "Candle lighting: minutes before sunset",
        "fr": "Allumage : minutes avant le coucher du soleil",
        "de": "Kerzenzünden: Minuten vor Sonnenuntergang",
        "es": "Encendido de velas: minutos antes de la puesta del sol"
      },
      "description": {
        "en": "18 in most communities, 40 in Jerusalem, 30 in Haifa, 20 in Tel Aviv.",
        "fr": "18 dans la plupart des communautés, 40 à Jérusalem, 30 à Haïfa, 20 à Tel-Aviv.",
        "de": "18 in den meisten Gemeinden, 40 in Jerusalem, 30 in Haifa, 20 in Tel Aviv.",
        "es": "18 en la mayoría de las comunidades, 40 en Jerusalén, 30 en Haifa, 20 en Tel Aviv."
      },
      "required": false,
      "default": 18,
      "min": 0,
      "max": 90
    },
    {
      "key": "havdalah",
      "type": "select",
      "label": {
        "en": "End of Shabbat and holidays",
        "fr": "Fin du chabbat et des fêtes",
        "de": "Ende von Schabbat und Feiertagen",
        "es": "Fin del Shabat y de las festividades"
      },
      "description": {
        "en": "When havdalah is shown: the sun 8.5° below the horizon (three small stars, hebcal.com default), or a fixed delay after sunset.",
        "fr": "Heure de la havdala : soleil à 8,5° sous l'horizon (trois petites étoiles, réglage par défaut de hebcal.com), ou délai fixe après le coucher du soleil.",
        "de": "Zeit der Hawdala: Sonne 8,5° unter dem Horizont (drei kleine Sterne, Standard von hebcal.com) oder eine feste Zeit nach Sonnenuntergang.",
        "es": "Hora de la havdalá: el sol a 8,5° bajo el horizonte (tres estrellas pequeñas, valor por defecto de hebcal.com) o un plazo fijo después de la puesta del sol."
      },
      "required": false,
      "default": "deg_8_5",
      "options": [
