{
  "name": "gladys-hebcal",
  "version": "1.0.0",
  "private": true,
  "description": "Gladys Assistant external integration: the Hebrew calendar of the house (date, Shabbat and holidays, candle lighting, havdalah, Torah portion, Omer), computed locally with @hebcal/core.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "@hebcal/core": "^6.14.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "GPL-3.0-or-later"
}
